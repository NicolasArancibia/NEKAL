rules_version = '2';
// Private account schema 2: typed entity envelopes, revision lock and immutable receipts.
// The V1 snapshot is frozen at migration start and retained as a recovery source.
// Profile roles are descriptive text only; authorization always uses the authenticated UID.
service cloud.firestore {
 match /databases/{database}/documents {
 function owner(uid) {return request.auth != null && request.auth.uid == uid;}
 function str(v,n) {return v is string && v.size() <= n;}
 function ident(v) {return str(v,200) && v.size()>0;}
 function fields(v,ks) {return v is map && v.keys().hasAll(ks) && v.keys().hasOnly(ks);}
 function hour(v) {return v is int && v>=0 && v<=23;}
 function logroIds() {return ['racha-3','racha-7','racha-14','racha-30','racha-60','racha-100','semana-perfecta','listas-10','listas-50','listas-100','listas-250','listas-500','listas-1000','nivel-5','nivel-10','nivel-15','nivel-20','primera-cosa','primera-mesa','primera-rutina','primera-meta','primer-dia-100','primer-audio','primer-plan','primer-amigo'];}
 function step(v) {return fields(v,['id','title','done']) && ident(v.id) && str(v.title,1000) && v.done is bool;}
 function reward(v,id) {return fields(v,['key','itemId','points','at','reason']) && ident(v.key) && v.itemId==id && v.points is number && v.points>=0 && v.points<=100000 && str(v.at,40) && str(v.reason,500);}
function origenOk(o) {return fields(o,['proveedor','cuenta','calendario','idExterno','version','firma','creadoEn','diaCompleto','soloLectura']) && o.proveedor in ['google','microsoft'] && o.creadoEn in ['fuera','nekal'] && o.diaCompleto is bool && o.soloLectura is bool && str(o.cuenta,1000) && str(o.calendario,1000) && str(o.idExterno,1000) && str(o.version,1000) && str(o.firma,1000);}
function itemKeys() {return ["id","type","title","description","workspaceId","createdAt","startDate","updatedAt","dueAt","scheduledAt","duration","flexible","status","priority","location","content","category","visitReason","participants","agenda","countsForScore","difficulty","attachments","groupId","x","y","deletedAt"];}
function item(v) {return (fields(v,itemKeys()) || (fields(v,itemKeys().concat(['origen'])) && origenOk(v.origen))) && ident(v.id) && ident(v.workspaceId) && str(v.groupId,200) && v.type in ['Nota','Idea','Evento','Visita','Meeting','Deadline','Goal','Tarea'] && str(v.title,160) && v.title.size()>0
&& str(v.description,100000) && str(v.content,100000) && str(v.location,100000) && str(v.category,100000) && str(v.visitReason,100000) && str(v.participants,100000) && str(v.agenda,100000)
&& str(v.createdAt,40) && str(v.startDate,40) && str(v.updatedAt,40) && str(v.dueAt,40) && str(v.scheduledAt,40) && str(v.deletedAt,40)
&& v.duration is number && v.duration>=0 && v.duration<=1440 && v.flexible is bool && v.countsForScore is bool && v.difficulty in [1,2,3] && v.status in ['pendiente','en curso','completado'] && v.priority in ['baja','media','urgente'] && v.x is number && v.y is number && v.attachments is list && v.attachments.size()<=3 && (v.attachments.size()<1 || ident(v.attachments[0])) && (v.attachments.size()<2 || ident(v.attachments[1])) && (v.attachments.size()<3 || ident(v.attachments[2]));}
function validValue(kind,id,v) {
return (kind=='items' && item(v))
|| (kind=='attachments' && fields(v,['id','itemId','name','mime','data']) && ident(v.id) && ident(v.itemId) && str(v.name,1000) && str(v.mime,200) && str(v.data,500000) && v.data.matches('data:.*'))
|| (kind=='workspaces' && ident(v.id) && str(v.name,500) && str(v.color,50) && (fields(v,['id','name','color']) || (fields(v,['id','name','color','area']) && v.area in ['estudio','trabajo','salud','hogar','social','personal'])))
|| (kind=='groups' && ident(v.id) && str(v.name,500) && ident(v.workspaceId) && (fields(v,['id','name','workspaceId']) || (fields(v,['id','name','workspaceId','parentId','repeat','repeatDays','repeatStart']) && str(v.parentId,200) && v.repeat in ['','diario','semanal','dias'] && v.repeatDays is list && v.repeatDays.size()<=7 && str(v.repeatStart,10))))
|| (kind=='messages' && ident(v.id) && str(v.text,100000) && v.isUser is bool && (fields(v,['id','text','isUser']) || (fields(v,['id','text','isUser','audio','plan','estado']) && v.audio is bool && str(v.plan,500) && v.estado in ['','pendiente','aceptado','descartado'])))
|| (kind=='rewards' && fields(v,['itemId']) && ident(v.itemId))
|| (kind=='steps' && fields(v,['itemId','order','id','title','done']) && ident(v.itemId) && ident(v.id) && str(v.title,1000) && v.done is bool && v.order is int && v.order>=0 && v.order<5000)
|| (kind=='dependencies' && fields(v,['itemId','targetId','order']) && ident(v.itemId) && ident(v.targetId) && v.order is int && v.order>=0 && v.order<5000)
|| (kind=='rewardEntries' && fields(v,['key','itemId','points','at','reason','order']) && ident(v.key) && ident(v.itemId) && v.points is number && v.points>=0 && v.points<=100000 && str(v.at,40) && str(v.reason,500) && v.order is int && v.order>=0 && v.order<10000)
|| (kind=='logros' && fields(v,['id','at']) && v.id==id && v.id in logroIds() && str(v.at,40))
|| (kind=='settings' && id=='profile' && fields(v,['name','roles']) && str(v.name,500) && str(v.roles,2000))
|| (kind=='settings' && id=='conexiones' && fields(v,['cuentas','ofrecido','destinoNekal']) && v.cuentas is list && v.cuentas.size()<=6 && v.ofrecido is bool && str(v.destinoNekal,320))
|| (kind=='settings' && id=='preferences' && fields(v,['softAlerts','quiet','quietStart','quietEnd','dayStart','dayEnd']) && v.softAlerts is bool && v.quiet is bool && hour(v.quietStart) && hour(v.quietEnd) && hour(v.dayStart) && hour(v.dayEnd) && v.dayStart<v.dayEnd);
}
function validRecord(kind,id) {return fields(request.resource.data,['value','updatedAt']) && request.resource.data.updatedAt==request.time && validValue(kind,id,request.resource.data.value);}
function migrating(uid) {return get(/databases/$(database)/documents/users/$(uid)/sync/meta).data.phase=='migrating';}
function revisionWrite(uid) {
let before=get(/databases/$(database)/documents/users/$(uid)/sync/meta).data;
let after=getAfter(/databases/$(database)/documents/users/$(uid)/sync/meta).data;
return before.phase=='ready' && after.phase=='ready' && after.revision==before.revision+1 && after.updatedAt==request.time;
}
match /users/{uid}/{kind}/{id} {
allow read: if owner(uid) && kind in ['items','attachments','workspaces','groups','messages','logros','rewards','settings','steps','dependencies','rewardEntries'];
allow create: if owner(uid) && validRecord(kind,id) && (migrating(uid) || revisionWrite(uid));
allow update: if owner(uid) && validRecord(kind,id) && revisionWrite(uid);
allow delete: if owner(uid) && kind in ['items','attachments','workspaces','groups','messages','logros','rewards','steps','dependencies','rewardEntries'] && revisionWrite(uid);
}
match /users/{uid}/sync/meta {
function validMeta() {let v=request.resource.data; return fields(v,['schema','phase','revision','legacyRevision','updatedAt']) && v.schema==2 && v.phase in ['migrating','ready'] && v.revision is int && v.revision>=0 && v.legacyRevision is int && v.legacyRevision>=0 && v.updatedAt==request.time;}
allow read: if owner(uid);
allow create: if owner(uid) && validMeta() && request.resource.data.phase=='migrating' && request.resource.data.revision==0;
allow update: if owner(uid) && validMeta() && request.resource.data.legacyRevision==resource.data.legacyRevision && request.resource.data.phase=='ready' && request.resource.data.revision==resource.data.revision+1;
}
match /users/{uid}/operations/{id} {
allow read: if owner(uid);
allow create: if owner(uid) && ident(id) && fields(request.resource.data,['at']) && request.resource.data.at==request.time && revisionWrite(uid);
}
match /users/{uid}/nekal/state {
allow read: if owner(uid);
// Read-only legacy backup. Old clients must reload to use schema 2.
}
// V2/F: amigos (spec F §5). Códigos, amistades y tarjetas fuera de la caja privada.
function codigoOk(c) {return c is string && c.matches('^[2-9A-HJKMNP-Z]{6}$');}
function nombreOk(v) {return v is string && v.size()>0 && v.size()<=80;}
function par(a,b) {return a < b ? a + '_' + b : b + '_' + a;}
function amigoDe(uid) {let p=/databases/$(database)/documents/amistades/$(par(uid, request.auth.uid)); return exists(p) && get(p).data.estado=='aceptada';}
function areaOk(a,k) {return !(k in a) || (fields(a[k],['valor','mesas']) && a[k].valor is int && a[k].valor>=0 && a[k].valor<=100 && a[k].mesas is int && a[k].mesas>=1 && a[k].mesas<=100);}
function tarjetaOk(uid) {let v=request.resource.data; return fields(v,['nombre','roles','desde','nivel','puntos','logros','areas','codigo','actualizado']) && nombreOk(v.nombre) && str(v.roles,200) && str(v.desde,10)
&& v.nivel is int && v.nivel>=1 && v.nivel<=200 && v.puntos is int && v.puntos>=0 && v.puntos<=10000000 && v.logros is list && v.logros.size()<=25 && v.logros.hasOnly(logroIds())
&& v.areas is map && v.areas.keys().hasOnly(['estudio','trabajo','salud','hogar','social','personal']) && areaOk(v.areas,'estudio') && areaOk(v.areas,'trabajo') && areaOk(v.areas,'salud') && areaOk(v.areas,'hogar') && areaOk(v.areas,'social') && areaOk(v.areas,'personal')
&& codigoOk(v.codigo) && getAfter(/databases/$(database)/documents/codigos/$(v.codigo)).data.uid==uid && v.actualizado==request.time;}
// Se envía solo con el código real de `para`; los nombres salen del código y de la tarjeta de quien envía.
function solicitudOk(id) {let v=request.resource.data; let c=get(/databases/$(database)/documents/codigos/$(v.codigo)).data; return fields(v,['de','para','miembros','estado','nombreDe','nombrePara','codigo','creada','aceptada'])
&& v.de==request.auth.uid && v.para is string && v.para!=v.de && id==par(v.de, v.para) && v.miembros==[v.de, v.para] && v.estado=='pendiente' && v.creada==request.time && v.aceptada==null
&& codigoOk(v.codigo) && c.uid==v.para && v.nombrePara==c.nombre && v.nombreDe==get(/databases/$(database)/documents/perfiles/$(v.de)).data.nombre;}
match /codigos/{codigo} {
// Un código por cuenta: el nuevo se crea junto a la tarjeta y en el mismo lote se borra el anterior.
allow get: if request.auth != null;
allow create: if request.auth != null && codigoOk(codigo) && fields(request.resource.data,['uid','nombre']) && request.resource.data.uid==request.auth.uid && nombreOk(request.resource.data.nombre)
&& getAfter(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.codigo==codigo
&& (!exists(/databases/$(database)/documents/perfiles/$(request.auth.uid)) || !existsAfter(/databases/$(database)/documents/codigos/$(get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.codigo)));
allow update: if request.auth != null && resource.data.uid==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']) && nombreOk(request.resource.data.nombre);
allow delete: if request.auth != null && resource.data.uid==request.auth.uid;
}
match /amistades/{id} {
allow read, delete: if request.auth != null && request.auth.uid in resource.data.miembros;
allow create: if request.auth != null && solicitudOk(id);
allow update: if request.auth != null && resource.data.para==request.auth.uid && resource.data.estado=='pendiente' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','aceptada'])
&& request.resource.data.estado=='aceptada' && request.resource.data.aceptada==request.time;
}
match /perfiles/{uid} {
allow read: if request.auth != null && (request.auth.uid==uid || amigoDe(uid));
allow create, update: if owner(uid) && tarjetaOk(uid);
allow delete: if owner(uid);
}
 }
}
